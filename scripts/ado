#!/bin/sh
# ado <verb> ...
# Azure DevOps WIT REST allowlist. Agents and /<prefix>setit-se call this script.
# They do not compose curl. Token stays in harness.credentials.local.json.

. "$(dirname "$0")/lib-ado.sh"

usage() {
  blocked "unexpected arguments" "usage: ado meta|get|create|set|comment|transition|link ..."
}

if [ $# -lt 1 ]; then
  usage
fi

verb=$1
shift

# --user-request "<the user's words>" (write verbs and get) lifts the
# agents.tracker.write guard for this call. Values of other options are skipped.
SEH_USER_REQUEST=
case $verb in
  get|create|set|comment|transition|link)
    _argc=$#
    while [ "$_argc" -gt 0 ]; do
      _arg=$1
      shift
      _argc=$((_argc - 1))
      case $_arg in
        --user-request)
          if [ "$_argc" -eq 0 ] || [ -z "$(printf '%s' "$1" | tr -d '[:space:]')" ]; then
            blocked "empty --user-request" "pass the user's own words"
          fi
          SEH_USER_REQUEST=$1
          shift
          _argc=$((_argc - 1))
          ;;
        --type|--title|--file)
          set -- "$@" "$_arg"
          if [ "$_argc" -gt 0 ]; then
            set -- "$@" "$1"
            shift
            _argc=$((_argc - 1))
          fi
          ;;
        *)
          set -- "$@" "$_arg"
          ;;
      esac
    done
    ;;
esac

parse_file_opt() {
  BODY_FILE=
  while [ $# -gt 0 ]; do
    case $1 in
      --file)
        if [ -z "${2-}" ]; then
          blocked "missing value for --file" "pass --file <path>"
        fi
        BODY_FILE=$2
        shift 2
        ;;
      *)
        blocked "unexpected arguments" "usage: ado $verb ... [--file <path>]"
        ;;
    esac
  done
  if [ -n "$BODY_FILE" ] && [ ! -f "$BODY_FILE" ]; then
    blocked "body file $BODY_FILE does not exist" "pass --file with a readable path, or stdin"
  fi
}

case $verb in
  meta)
    if [ $# -ne 0 ]; then
      usage
    fi
    load_ado
    _seg=$(ado_json project-encoded "$SEH_ADO_CFG")
    _wit="/${_seg}/_apis/wit"
    _api=$(ado_json api-version)
    _types=$(mktemp)
    trap 'rm -f "$SEH_ADO_CURL_CFG" "$SEH_ADO_BODY" "$_types"' EXIT
    # Fields come from the project's work item types, not /_apis/wit/fields,
    # which lists every field in the organization.
    ado_http GET "${_wit}/workitemtypes?api-version=${_api}&%24expand=states"
    cp "$SEH_ADO_BODY" "$_types"
    _out=$(ado_json format-meta "$_types")
    _proj=$(ado_json project "$SEH_ADO_CFG")
    printf 'OK\n'
    printf 'project: %s\n' "$_proj"
    printf '%s\n' "$_out"
    exit 0
    ;;

  get)
    if [ $# -ne 1 ]; then
      blocked "unexpected arguments" "usage: ado get <work-item-id>|<basename>"
    fi
    require_write_block
    # A basename whose local spec has tracker: reads that work item.
    _base=$1
    _id=$(ado_json resolve-key "$(config_path)" "$_base")
    require_task "$_id"
    load_ado
    _seg=$(ado_json project-encoded "$SEH_ADO_CFG")
    _wit="/${_seg}/_apis/wit"
    _api=$(ado_json api-version)
    _capi=$(ado_json comments-api-version)
    _fields=$(ado_json fetch-fields "$SEH_ADO_CFG")
    _item=$(mktemp)
    _comments=$(mktemp)
    trap 'rm -f "$SEH_ADO_CURL_CFG" "$SEH_ADO_BODY" "$_item" "$_comments"' EXIT
    ado_http GET "${_wit}/workitems/${_id}?fields=${_fields}&api-version=${_api}"
    cp "$SEH_ADO_BODY" "$_item"
    if [ "$(ado_json needs-comments "$SEH_ADO_CFG" "$SEH_USER_REQUEST")" = "true" ]; then
      ado_http GET "${_wit}/workitems/${_id}/comments?api-version=${_capi}"
      cp "$SEH_ADO_BODY" "$_comments"
    else
      printf '{}\n' > "$_comments"
    fi
    _out=$(ado_json format-get "$SEH_ADO_CFG" "$_item" "$_comments" "$_base" "$SEH_USER_REQUEST")
    printf 'OK\n'
    printf '%s\n' "$_out"
    exit 0
    ;;

  create)
    _type=
    _title=
    while [ $# -gt 0 ]; do
      case $1 in
        --type)
          if [ -z "${2-}" ]; then
            blocked "missing value for --type" "usage: ado create --type feature|bug --title <text>"
          fi
          _type=$2
          shift 2
          ;;
        --title)
          if [ -z "${2-}" ]; then
            blocked "missing value for --title" "usage: ado create --type feature|bug --title <text>"
          fi
          _title=$2
          shift 2
          ;;
        *)
          blocked "unexpected arguments" "usage: ado create --type feature|bug --title <text>"
          ;;
      esac
    done
    case $_type in
      feature|bug) ;;
      *)
        blocked "invalid work item type $_type" "usage: ado create --type feature|bug --title <text>"
        ;;
    esac
    if [ -z "$_title" ]; then
      blocked "missing --title" "usage: ado create --type feature|bug --title <text>"
    fi
    guard_write create
    load_ado
    if ! _enc=$(ado_json type-encoded "$SEH_ADO_CFG" "$_type" 2>/dev/null); then
      blocked "work item type $_type is not mapped" "set agents.tracker.workItemTypes in /<prefix>setit-se"
    fi
    _seg=$(ado_json project-encoded "$SEH_ADO_CFG")
    _api=$(ado_json api-version)
    _payload=$(mktemp)
    trap 'rm -f "$SEH_ADO_CURL_CFG" "$SEH_ADO_BODY" "$_payload"' EXIT
    ado_json create-body "$_title" > "$_payload"
    ado_http POST "/${_seg}/_apis/wit/workitems/${_enc}?api-version=${_api}" "$_payload" "$(ado_json patch-content-type)"
    _id=$(ado_json extract-id "$SEH_ADO_BODY")
    ok "id: ${_id}"
    ;;

  set)
    if [ $# -lt 2 ]; then
      blocked "unexpected arguments" "usage: ado set <work-item-id> spec|prompt|log [--file <path>]"
    fi
    require_task "$1"
    _id=$1
    _kind=$2
    shift 2
    case $_kind in
      spec|prompt|log) ;;
      *)
        blocked "invalid field $_kind" "usage: ado set <work-item-id> spec|prompt|log [--file <path>]"
        ;;
    esac
    parse_file_opt "$@"
    guard_write "$_kind"
    load_ado
    _loc=$(ado_json mapped-field "$SEH_ADO_CFG" "$_kind")
    if [ -z "$_loc" ]; then
      blocked "$_kind is not mapped" "set agents.tracker.fields in /<prefix>setit-se"
    fi
    _src=$(read_body_file "$BODY_FILE")
    _seg=$(ado_json project-encoded "$SEH_ADO_CFG")
    _wit="/${_seg}/_apis/wit"
    _api=$(ado_json api-version)
    _payload=$(mktemp)
    _item=$(mktemp)
    trap 'rm -f "$SEH_ADO_CURL_CFG" "$SEH_ADO_BODY" "$_payload" "$_item"' EXIT
    if [ "$_loc" = "comment" ]; then
      ado_json set-body "$SEH_ADO_CFG" "$_kind" "$_src" > "$_payload"
      ado_http POST "${_wit}/workitems/${_id}/comments?api-version=$(ado_json comments-api-version)" "$_payload"
      ok "id: ${_id}" "field: ${_kind}" "location: comment"
    fi
    if [ "$_kind" = "log" ] && [ "$_loc" != "history" ]; then
      _fields=$(ado_json fetch-fields "$SEH_ADO_CFG")
      ado_http GET "${_wit}/workitems/${_id}?fields=${_fields}&api-version=${_api}"
      cp "$SEH_ADO_BODY" "$_item"
      ado_json set-body "$SEH_ADO_CFG" "$_kind" "$_src" "$_item" > "$_payload"
    else
      ado_json set-body "$SEH_ADO_CFG" "$_kind" "$_src" > "$_payload"
    fi
    ado_http PATCH "${_wit}/workitems/${_id}?api-version=${_api}" "$_payload" "$(ado_json patch-content-type)"
    ok "id: ${_id}" "field: ${_kind}" "location: ${_loc}"
    ;;

  comment)
    if [ $# -lt 1 ]; then
      blocked "unexpected arguments" "usage: ado comment <work-item-id> [--file <path>]"
    fi
    require_task "$1"
    _id=$1
    shift
    parse_file_opt "$@"
    guard_write log
    load_ado
    _src=$(read_body_file "$BODY_FILE")
    _seg=$(ado_json project-encoded "$SEH_ADO_CFG")
    _api=$(ado_json comments-api-version)
    _payload=$(mktemp)
    trap 'rm -f "$SEH_ADO_CURL_CFG" "$SEH_ADO_BODY" "$_payload"' EXIT
    ado_json comment-body "$_src" > "$_payload"
    ado_http POST "/${_seg}/_apis/wit/workitems/${_id}/comments?api-version=${_api}" "$_payload"
    ok "id: ${_id}"
    ;;

  transition)
    if [ $# -ne 2 ]; then
      blocked "unexpected arguments" "usage: ado transition <work-item-id> todo|inProgress|codeReview|inReview|done"
    fi
    require_task "$1"
    _id=$1
    _step=$2
    case $_step in
      todo|inProgress|codeReview|inReview|done) ;;
      *)
        blocked "invalid status key $_step" "usage: ado transition <work-item-id> todo|inProgress|codeReview|inReview|done"
        ;;
    esac
    guard_write status
    SEH_ADO_CFG=$(config_path)
    if ! _want=$(ado_json status-map "$SEH_ADO_CFG" "$_step"); then
      blocked "invalid status key $_step" "fix agents.tracker.statuses in /<prefix>setit-se"
    fi
    if [ "$_want" = "NULL" ]; then
      unchanged "id: ${_id}" "step: ${_step}" "status: skipped"
    fi
    load_ado
    _seg=$(ado_json project-encoded "$SEH_ADO_CFG")
    _wit="/${_seg}/_apis/wit"
    _api=$(ado_json api-version)
    _item=$(mktemp)
    _payload=$(mktemp)
    trap 'rm -f "$SEH_ADO_CURL_CFG" "$SEH_ADO_BODY" "$_item" "$_payload"' EXIT
    ado_http GET "${_wit}/workitems/${_id}?fields=System.State&api-version=${_api}"
    cp "$SEH_ADO_BODY" "$_item"
    _cur=$(ado_json current-state "$_item")
    if [ "$_cur" = "$_want" ]; then
      unchanged "id: ${_id}" "status: ${_want}"
    fi
    # No transitions API: PATCH the mapped state and let ADO reject illegal ones.
    ado_json state-body "$_want" > "$_payload"
    ado_http PATCH "${_wit}/workitems/${_id}?api-version=${_api}" "$_payload" "$(ado_json patch-content-type)"
    ok "id: ${_id}" "status: ${_want}"
    ;;

  link)
    if [ $# -ne 3 ]; then
      blocked "unexpected arguments" "usage: ado link <work-item-id> depends|relates <other-id>"
    fi
    require_task "$1"
    require_task "$3"
    _id=$1
    _rel=$2
    _other=$3
    case $_rel in
      depends|relates) ;;
      *)
        blocked "invalid link type $_rel" "usage: ado link <work-item-id> depends|relates <other-id>"
        ;;
    esac
    guard_write create
    load_ado
    _seg=$(ado_json project-encoded "$SEH_ADO_CFG")
    _api=$(ado_json api-version)
    _payload=$(mktemp)
    trap 'rm -f "$SEH_ADO_CURL_CFG" "$SEH_ADO_BODY" "$_payload"' EXIT
    ado_json link-body "$_rel" "$SEH_ADO_URL" "$_other" > "$_payload"
    ado_http PATCH "/${_seg}/_apis/wit/workitems/${_id}?api-version=${_api}" "$_payload" "$(ado_json patch-content-type)"
    ok "id: ${_id}" "link: ${_rel}" "other: ${_other}"
    ;;

  *)
    usage
    ;;
esac
