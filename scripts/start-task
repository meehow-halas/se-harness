#!/bin/sh
# start-task <task>
# Create or reuse a git worktree for the task branch. Does not switch the caller.
# Reads project-root harness.config.json. No commit, no push.
# Invoked as .dhs/scripts/start-task after dhs install.

. "$(dirname "$0")/lib.sh"

require_git
require_task "${1-}"
task=$1
if [ $# -ne 1 ]; then
  blocked "unexpected arguments" "usage: start-task <task>"
fi

read_base_branch
base=$DHS_BASE_BRANCH
require_not_base "$task" "$base"

launch=$(repo_root)
wt=$(dhs_worktree_path "$task")

finish() {
  _status=$1
  shift
  sync_launch_files "$launch" "$wt" "$task"
  if [ "$_status" = "unchanged" ]; then
    unchanged "$@"
  fi
  ok "$@"
}

existing=$(worktree_path_for_branch "$task")
if [ -n "$existing" ]; then
  wt=$existing
  if [ "$launch" = "$wt" ]; then
    finish unchanged "branch: $task" "base: $base" "created: no" "worktree: $wt"
  fi
  finish unchanged "branch: $task" "base: $base" "created: no" "worktree: $wt"
fi

mkdir -p "$(dirname "$wt")"

if local_branch_exists "$task"; then
  if ! out=$(git worktree add "$wt" "$task" 2>&1); then
    blocked "could not add worktree for $task ($out)" "remove a stale worktree or retry start-task"
  fi
  finish ok "branch: $task" "base: $base" "created: no" "worktree: $wt"
fi

if remote_branch_exists "$task"; then
  if ! out=$(git worktree add -b "$task" "$wt" "origin/$task" 2>&1); then
    blocked "could not add worktree from origin/$task ($out)" "fetch origin/$task, then retry start-task"
  fi
  finish ok "branch: $task" "base: $base" "created: no" "worktree: $wt"
fi

if ! local_branch_exists "$base"; then
  blocked "base branch $base does not exist locally" "check out or fetch that branch, or set agents.baseBranch in /dhs-setup"
fi

if ! out=$(git worktree add -b "$task" "$wt" "$base" 2>&1); then
  blocked "could not create $task from $base ($out)" "remove a stale path under .git/dhs-worktrees, then retry start-task"
fi

finish ok "branch: $task" "base: $base" "created: yes" "worktree: $wt"
