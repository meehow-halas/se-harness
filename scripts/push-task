#!/bin/sh
# push-task <task>
# Push only the task branch. No force. Does not push agents.baseBranch.

. "$(dirname "$0")/lib.sh"

require_git
require_task "${1-}"
task=$1
if [ $# -ne 1 ]; then
  blocked "unexpected arguments" "usage: push-task <task>"
fi

read_base_branch
base=$DHS_BASE_BRANCH
require_not_base "$task" "$base"

if ! local_branch_exists "$task"; then
  blocked "task branch $task does not exist" "run start-task $task, then retry push-task"
fi

push_remote
remote=$DHS_REMOTE

if ! out=$(git push --porcelain "$remote" "$task" 2>&1); then
  blocked "push of $task to $remote failed ($out)" "fix the remote rejection without force, then retry push-task"
fi

case $out in
  *" [up to date] "*|*"up to date"*)
    unchanged "branch: $task" "remote: $remote"
    ;;
esac

ok "branch: $task" "remote: $remote"
