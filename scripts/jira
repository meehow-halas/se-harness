#!/bin/sh
# jira <verb> ...
# Jira Cloud REST v3 allowlist. Agents and /{{prefix}}setit-se call this script.
# They do not compose curl. Token stays in harness.credentials.local.json.

. "$(dirname "$0")/lib-jira.sh"

usage() {
  blocked "unexpected arguments" "usage: jira meta|get|create|set|comment|transition|link ..."
}

if [ $# -lt 1 ]; then
  usage
fi

verb=$1
shift

# --user-request "<the user's words>" (write verbs and get) lifts the
# agents.tracker.write guard for this call. Values of other options are skipped.
SEH_USER_REQUEST=
case $verb in
  get|create|set|comment|transition|link)
    _argc=$#
    while [ "$_argc" -gt 0 ]; do
      _arg=$1
      shift
      _argc=$((_argc - 1))
      case $_arg in
        --user-request)
          if [ "$_argc" -eq 0 ] || [ -z "$(printf '%s' "$1" | tr -d '[:space:]')" ]; then
            blocked "empty --user-request" "pass the user's own words"
          fi
          SEH_USER_REQUEST=$1
          shift
          _argc=$((_argc - 1))
          ;;
        --type|--title|--file)
          set -- "$@" "$_arg"
          if [ "$_argc" -gt 0 ]; then
            set -- "$@" "$1"
            shift
            _argc=$((_argc - 1))
          fi
          ;;
        *)
          set -- "$@" "$_arg"
          ;;
      esac
    done
    ;;
esac

parse_file_opt() {
  BODY_FILE=
  while [ $# -gt 0 ]; do
    case $1 in
      --file)
        if [ -z "${2-}" ]; then
          blocked "missing value for --file" "pass --file <path>"
        fi
        BODY_FILE=$2
        shift 2
        ;;
      *)
        blocked "unexpected arguments" "usage: jira $verb ... [--file <path>]"
        ;;
    esac
  done
}

case $verb in
  meta)
    if [ $# -ne 0 ]; then
      usage
    fi
    load_jira
    _project=$(jira_json project-key "$SEH_JIRA_CFG")
    _st=$(mktemp)
    trap 'rm -rf "$SEH_JIRA_CURL_CFG" "$SEH_JIRA_BODY" "$_st" "${_fl-}"' EXIT
    jira_http GET "/rest/api/3/project/${_project}/statuses"
    cp "$SEH_JIRA_BODY" "$_st"
    # Fields come from the project's create screens (createmeta per issue
    # type), not /rest/api/3/field, which lists every field on the site.
    _fl=$(mktemp -d)
    _n=0
    for _tid in $(jira_json issue-type-ids "$_st"); do
      _start=0
      while [ -n "$_start" ]; do
        jira_http GET "/rest/api/3/issue/createmeta/${_project}/issuetypes/${_tid}?startAt=${_start}&maxResults=200"
        _n=$((_n + 1))
        cp "$SEH_JIRA_BODY" "$_fl/$_n.json"
        _start=$(jira_json next-start "$SEH_JIRA_BODY" "$_start")
      done
    done
    _out=$(jira_json format-meta "$_st" "$_fl")
    _pk=$(jira_json project-key "$SEH_JIRA_CFG")
    printf 'OK\n'
    printf 'projectKey: %s\n' "$_pk"
    printf '%s\n' "$_out"
    exit 0
    ;;

  get)
    if [ $# -ne 1 ]; then
      blocked "unexpected arguments" "usage: jira get <issue-key>|<basename>"
    fi
    require_write_block
    # A basename whose local spec has tracker: reads that issue.
    _base=$1
    _key=$(jira_json resolve-key "$(config_path)" "$_base")
    require_task "$_key"
    load_jira
    _fields=$(jira_json fetch-fields "$SEH_JIRA_CFG")
    _issue=$(mktemp)
    _comments=$(mktemp)
    trap 'rm -f "$SEH_JIRA_CURL_CFG" "$SEH_JIRA_BODY" "$_issue" "$_comments"' EXIT
    jira_http GET "/rest/api/3/issue/${_key}?fields=${_fields}"
    cp "$SEH_JIRA_BODY" "$_issue"
    jira_http GET "/rest/api/3/issue/${_key}/comment"
    cp "$SEH_JIRA_BODY" "$_comments"
    _out=$(jira_json format-get "$SEH_JIRA_CFG" "$_issue" "$_comments" "$_base" "$SEH_USER_REQUEST")
    printf 'OK\n'
    printf '%s\n' "$_out"
    exit 0
    ;;

  create)
    _type=
    _title=
    while [ $# -gt 0 ]; do
      case $1 in
        --type)
          if [ -z "${2-}" ]; then
            blocked "missing value for --type" "usage: jira create --type feature|bug --title <text>"
          fi
          _type=$2
          shift 2
          ;;
        --title)
          if [ -z "${2-}" ]; then
            blocked "missing value for --title" "usage: jira create --type feature|bug --title <text>"
          fi
          _title=$2
          shift 2
          ;;
        *)
          blocked "unexpected arguments" "usage: jira create --type feature|bug --title <text>"
          ;;
      esac
    done
    case $_type in
      feature|bug) ;;
      *)
        blocked "invalid issue type $_type" "usage: jira create --type feature|bug --title <text>"
        ;;
    esac
    if [ -z "$_title" ]; then
      blocked "missing --title" "usage: jira create --type feature|bug --title <text>"
    fi
    guard_write create
    load_jira
    if ! jira_json issue-type "$SEH_JIRA_CFG" "$_type" >/dev/null; then
      blocked "issue type $_type is not mapped" "set agents.tracker.issueTypes in /{{prefix}}setit-se"
    fi
    _payload=$(mktemp)
    trap 'rm -f "$SEH_JIRA_CURL_CFG" "$SEH_JIRA_BODY" "$_payload"' EXIT
    jira_json create-body "$SEH_JIRA_CFG" "$_type" "$_title" > "$_payload"
    jira_http POST "/rest/api/3/issue" "$_payload"
    _key=$(jira_json extract-key "$SEH_JIRA_BODY")
    ok "key: ${_key}"
    ;;

  set)
    if [ $# -lt 2 ]; then
      blocked "unexpected arguments" "usage: jira set <issue-key> spec|prompt|log [--file <path>]"
    fi
    require_task "$1"
    _key=$1
    _kind=$2
    shift 2
    case $_kind in
      spec|prompt|log) ;;
      *)
        blocked "invalid field $_kind" "usage: jira set <issue-key> spec|prompt|log [--file <path>]"
        ;;
    esac
    parse_file_opt "$@"
    guard_write "$_kind"
    load_jira
    _loc=$(jira_json mapped-field "$SEH_JIRA_CFG" "$_kind")
    if [ -z "$_loc" ]; then
      blocked "$_kind is not mapped" "set agents.tracker.fields in /{{prefix}}setit-se"
    fi
    _src=$(read_body_file "$BODY_FILE")
    _payload=$(mktemp)
    _issue=$(mktemp)
    trap 'rm -f "$SEH_JIRA_CURL_CFG" "$SEH_JIRA_BODY" "$_payload" "$_issue"' EXIT
    if [ "$_loc" = "comment" ]; then
      jira_json set-body "$SEH_JIRA_CFG" "$_kind" "$_src" > "$_payload"
      jira_http POST "/rest/api/3/issue/${_key}/comment" "$_payload"
      ok "key: ${_key}" "field: ${_kind}" "location: comment"
    else
      if [ "$_kind" = "log" ] && [ "$_loc" != "description" ]; then
        _fields=$(jira_json fetch-fields "$SEH_JIRA_CFG")
        jira_http GET "/rest/api/3/issue/${_key}?fields=${_fields}"
        cp "$SEH_JIRA_BODY" "$_issue"
        jira_json set-body "$SEH_JIRA_CFG" "$_kind" "$_src" "$_issue" > "$_payload"
      else
        jira_json set-body "$SEH_JIRA_CFG" "$_kind" "$_src" > "$_payload"
      fi
      jira_http PUT "/rest/api/3/issue/${_key}" "$_payload"
      ok "key: ${_key}" "field: ${_kind}" "location: ${_loc}"
    fi
    ;;

  comment)
    if [ $# -lt 1 ]; then
      blocked "unexpected arguments" "usage: jira comment <issue-key> [--file <path>]"
    fi
    require_task "$1"
    _key=$1
    shift
    parse_file_opt "$@"
    guard_write log
    load_jira
    _src=$(read_body_file "$BODY_FILE")
    _payload=$(mktemp)
    trap 'rm -f "$SEH_JIRA_CURL_CFG" "$SEH_JIRA_BODY" "$_payload"' EXIT
    jira_json comment-body "$_src" > "$_payload"
    jira_http POST "/rest/api/3/issue/${_key}/comment" "$_payload"
    ok "key: ${_key}"
    ;;

  transition)
    if [ $# -ne 2 ]; then
      blocked "unexpected arguments" "usage: jira transition <issue-key> todo|inProgress|codeReview|inReview|done"
    fi
    require_task "$1"
    _key=$1
    _step=$2
    case $_step in
      todo|inProgress|codeReview|inReview|done) ;;
      *)
        blocked "invalid status key $_step" "usage: jira transition <issue-key> todo|inProgress|codeReview|inReview|done"
        ;;
    esac
    guard_write status
    SEH_JIRA_CFG=$(config_path)
    if ! _want=$(jira_json status-map "$SEH_JIRA_CFG" "$_step"); then
      blocked "invalid status key $_step" "fix agents.tracker.statuses in /{{prefix}}setit-se"
    fi
    if [ "$_want" = "NULL" ]; then
      unchanged "key: ${_key}" "step: ${_step}" "status: skipped"
    fi
    load_jira
    _issue=$(mktemp)
    _tr=$(mktemp)
    trap 'rm -f "$SEH_JIRA_CURL_CFG" "$SEH_JIRA_BODY" "$_issue" "$_tr" "${_payload-}"' EXIT
    jira_http GET "/rest/api/3/issue/${_key}?fields=status"
    cp "$SEH_JIRA_BODY" "$_issue"
    _cur=$(jira_json current-status "$_issue")
    if [ "$_cur" = "$_want" ]; then
      unchanged "key: ${_key}" "status: ${_want}"
    fi
    jira_http GET "/rest/api/3/issue/${_key}/transitions"
    cp "$SEH_JIRA_BODY" "$_tr"
    if ! _tid=$(jira_json pick-transition "$_tr" "$_want"); then
      blocked "mapped status ${_want} is not on this issue type's workflow" "fix the mapping in /{{prefix}}setit-se"
    fi
    _payload=$(mktemp)
    jira_json transition-body "$_tid" > "$_payload"
    jira_http POST "/rest/api/3/issue/${_key}/transitions" "$_payload"
    ok "key: ${_key}" "status: ${_want}"
    ;;

  link)
    if [ $# -ne 3 ]; then
      blocked "unexpected arguments" "usage: jira link <issue-key> depends|relates <other-key>"
    fi
    require_task "$1"
    require_task "$3"
    _key=$1
    _rel=$2
    _other=$3
    case $_rel in
      depends|relates) ;;
      *)
        blocked "invalid link type $_rel" "usage: jira link <issue-key> depends|relates <other-key>"
        ;;
    esac
    guard_write create
    load_jira
    _payload=$(mktemp)
    trap 'rm -f "$SEH_JIRA_CURL_CFG" "$SEH_JIRA_BODY" "$_payload"' EXIT
    jira_json link-body "$_key" "$_rel" "$_other" > "$_payload"
    jira_http POST "/rest/api/3/issueLink" "$_payload"
    ok "key: ${_key}" "link: ${_rel}" "other: ${_other}"
    ;;

  *)
    usage
    ;;
esac
