#!/bin/sh
# push-task <task> [--user-request <words>]
# Push only the task branch. No force. Does not push agents.baseBranch.
# Push disabled in agents.git: UNCHANGED, unless --user-request carries the
# user's explicit request.

. "$(dirname "$0")/lib.sh"

git_gate
require_git
usage='usage: push-task <task> [--user-request <words>]'
task=
user_request=
while [ $# -gt 0 ]; do
  case $1 in
    --user-request)
      require_user_request "${2-}"
      user_request=$2
      shift 2
      ;;
    *)
      if [ -n "$task" ]; then
        blocked "unexpected arguments" "$usage"
      fi
      require_task "$1"
      task=$1
      shift
      ;;
  esac
done
require_task "$task"

read_base_branch
base=$SEH_BASE_BRANCH
require_not_base "$task" "$base"
git_op_gate push "$user_request"

resolve_task_branch "$task"
branch=$SEH_BRANCH
if ! local_branch_exists "$branch"; then
  hint=$(missing_branch_hint "$task" push-task)
  blocked "task branch $branch does not exist" "$hint"
fi

push_remote
remote=$SEH_REMOTE

if ! out=$(git push --porcelain "$remote" "$branch" 2>&1); then
  blocked "push of $branch to $remote failed ($out)" "fix the remote rejection without force, then retry push-task"
fi

case $out in
  *" [up to date] "*|*"up to date"*)
    unchanged "branch: $branch" "remote: $remote"
    ;;
esac

ok "branch: $branch" "remote: $remote"
