#!/bin/sh
# start-task <task> [--existing] [--user-request <words>]
# Create or reuse a git worktree for the task branch. Does not switch the caller.
# --existing (review): only reuse or attach; BLOCKED instead of a new branch.
# Reads project-root harness.config.json. Copies this task's file-tracker files
# into the worktree, then removes uncommitted copies of those paths from launch.
# No commit, no push, no uncommit.
# agents.git.worktree off: UNCHANGED with the launch checkout, unless
# --user-request carries the user's explicit request.
# Invoked as .seh/scripts/start-task after seh install.

. "$(dirname "$0")/lib.sh"

git_gate "worktree: $(project_root)"
require_git
usage='usage: start-task <task> [--existing] [--user-request <words>]'
task=
user_request=
existing_only=
while [ $# -gt 0 ]; do
  case $1 in
    --existing)
      existing_only=yes
      shift
      ;;
    --user-request)
      require_user_request "${2-}"
      user_request=$2
      shift 2
      ;;
    *)
      if [ -n "$task" ]; then
        blocked "unexpected arguments" "$usage"
      fi
      require_task "$1"
      task=$1
      shift
      ;;
  esac
done
require_task "$task"

read_base_branch
base=$SEH_BASE_BRANCH
require_not_base "$task" "$base"

launch=$(repo_root)
git_op_gate worktree "$user_request" "worktree: $launch"
wt=$(seh_worktree_path "$task")

finish() {
  _status=$1
  shift
  sync_launch_files "$launch" "$wt" "$task"
  if [ "$_status" = "unchanged" ]; then
    unchanged "$@"
  fi
  ok "$@"
}

existing=$(worktree_path_for_branch "$task")
if [ -n "$existing" ]; then
  wt=$existing
  if [ "$launch" = "$wt" ]; then
    finish unchanged "branch: $task" "base: $base" "created: no" "worktree: $wt"
  fi
  finish unchanged "branch: $task" "base: $base" "created: no" "worktree: $wt"
fi

mkdir -p "$(dirname "$wt")"

# A branch with a closed or merged PR is history. New work goes to <task>-N
# so it does not add commits to that old PR (see branch_is_historical).
branch=$task
if local_branch_exists "$task" || remote_branch_exists "$task"; then
  if branch_is_historical "$task"; then
    branch=$(next_task_branch "$task")
  fi
fi

if [ "$branch" = "$task" ] && local_branch_exists "$task"; then
  if ! out=$(git worktree add "$wt" "$task" 2>&1); then
    blocked "could not add worktree for $task ($out)" "remove a stale worktree or retry start-task"
  fi
  finish ok "branch: $task" "base: $base" "created: no" "worktree: $wt"
fi

if [ "$branch" = "$task" ] && remote_branch_exists "$task"; then
  if ! out=$(git worktree add -b "$task" "$wt" "origin/$task" 2>&1); then
    blocked "could not add worktree from origin/$task ($out)" "fetch origin/$task, then retry start-task"
  fi
  finish ok "branch: $task" "base: $base" "created: no" "worktree: $wt"
fi

if [ -n "$existing_only" ]; then
  blocked "no worktree or branch holds the work of $task" "if it is uncommitted in $launch, turn the worktree operation off in /{{prefix}}setit-se and rerun; if it is elsewhere, bring it to branch $task or fetch origin/$task"
fi

# Cut from the remote base when there is one: a local base can be behind
# origin (someone merged a PR), and a task branch cut from it misses those commits.
base_ref=$base
if git remote | grep -qx origin; then
  if ! out=$(git fetch --quiet origin "$base" 2>&1); then
    blocked "could not fetch origin/$base ($out)" "check the remote and network, then retry start-task"
  fi
  if remote_branch_exists "$base"; then
    base_ref="origin/$base"
  fi
fi

if [ "$base_ref" = "$base" ] && ! local_branch_exists "$base"; then
  blocked "base branch $base does not exist locally" "check out or fetch that branch, or set agents.baseBranch in /{{prefix}}setit-se"
fi

if ! out=$(git worktree add -b "$branch" "$wt" "$base_ref" 2>&1); then
  blocked "could not create $branch from $base_ref ($out)" "remove a stale path under .git/seh-worktrees, then retry start-task"
fi

finish ok "branch: $branch" "base: $base" "created: yes" "worktree: $wt"
